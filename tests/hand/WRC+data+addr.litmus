AArch64 WRC+data+addr
"Write-to-read causality: forbidden because ARMv8 is multicopy-atomic"
{
0:X1=x;
1:X1=x; 1:X3=y;
2:X1=y; 2:X4=x;
}
 P0          | P1           | P2                  ;
 MOV W0,#1   | LDR W0,[X1]  | LDR W0,[X1]         ;
 STR W0,[X1] | EOR W2,W0,W0 | EOR W2,W0,W0        ;
             | ADD W2,W2,#1 | LDR W3,[X4,W2,SXTW] ;
             | STR W2,[X3]  |                     ;
exists
(1:X0=1 /\ 2:X0=1 /\ 2:X3=0)
