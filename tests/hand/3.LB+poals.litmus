AArch64 3.LB+poals
"Load buffering on three threads, each a load-acquire then a store-release"
{
0:X1=x; 0:X3=y;
1:X1=y; 1:X3=z;
2:X1=z; 2:X3=x;
}
 P0           | P1           | P2           ;
 LDAR W0,[X1] | LDAR W0,[X1] | LDAR W0,[X1] ;
 MOV W2,#1    | MOV W2,#1    | MOV W2,#1    ;
 STLR W2,[X3] | STLR W2,[X3] | STLR W2,[X3] ;
exists
(0:X0=1 /\ 1:X0=1 /\ 2:X0=1)
