AArch64 WRC+poal+poaa+L
"Write-to-read causality with release and acquire only"
{
0:X1=x;
1:X1=x; 1:X3=y;
2:X1=y; 2:X3=x;
}
 P0           | P1           | P2           ;
 MOV W0,#1    | LDAR W0,[X1] | LDAR W0,[X1] ;
 STLR W0,[X1] | MOV W2,#1    | LDAR W2,[X3] ;
              | STLR W2,[X3] |              ;
exists
(1:X0=1 /\ 2:X0=1 /\ 2:X2=0)
